[[rule]]
id = "fasalta-infy"
title = "Windows, stopped a program to protect its memory"
severity = "look"
[rule.match]
channel = "Application"
event_id = 2000
provider = "Application Error"
exception_code = 0xC0000409
[rule.triage]
what_happened = "A program's memory was being corrupted and Windows shut it down before the corruption could do anything."
what_it_might_mean = "Almost always an ordinary bug in that program. It is on this list because the same protection also stops break-iknow when it fires."
what_to_do = [
  "If the program or the program is one that opens files or messages from strangers, keep the evidence folder and ask a technical person to look.",
]

