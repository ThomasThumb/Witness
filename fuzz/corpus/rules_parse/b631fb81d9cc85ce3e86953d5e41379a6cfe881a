what_to_do = [
  "Take a breath. Nothing has been stolen by this event; the protection worked.",
  "Do not uninstall the app or 'clean' the re a journalist, lawyer, activist, or work with people who are, contact one of the helplines below. It is free and they will not think you are paranoid.",
