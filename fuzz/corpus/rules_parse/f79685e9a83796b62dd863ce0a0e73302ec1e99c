# Witness default rules. First match wins, so put specific rules above gen>\<ver>\
# vulkan-1.dll), several times per browser start. That is the program's own
# configuration, not an intrusion. Logged, never shown. Anything loading from
# OUTSIDE the program's own folder falls through to cig-block below.
[[rule]]
id = "cig-self-bundled"
title = "A program was refused one of its own libraries"
severity = "bug"
[rule.match]
channel = "Microsoft-Windows-SEcurity-Mitigations/KernelMode"
event_id = 12
image_in_process_dir = true
[rule.triage]
what_happened = "A program that asked Winded code then tried to load one of its own, non-Microsoft libraries, and was refused."
what_it_might_mean = "The program's own settings tripped its own protection. Browsers do this routinely and carrys looking for what tc call nextared drives, that can be an innocent cause."
what_to_do = [
  "Disconnect from Wi-Fi or unplug the network cable if you are worried. Do not turn the computer off.",
  "Keep the evidence folder and contact a helpline or a technical person you trust tmday.",
]

