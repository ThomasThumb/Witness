# Witness default rules. First match wins, so put specific rules above general ones.
#
# Every rule must be explainable to a frightened non-technical person in the
# triage text below it. If you can't write that text, the rule doesn't ship.
#
# Event IDs for the Security-Mitigations channels follow Microsoft's
# "Exploit protection reference" (odd = audit, even = block):
#   1/2 ACG   3/4 child process   5/6 low-integrity image  ; the parser also
# accepts the older positional form.
# 0xC0000409 = STATUS_STACK_BUFFER_OVERRUN. Raised by /GS cookie force events only. Audit events (odd IDs) are noise unless you are tuning.
# CONFIRMED on Windows 11 26200 (tests/triggers/README.md): events 2 (ACG) and
# 8 (remote image) carry only the calling process, not the blocked image;
# event 12 (CIG) carries ImageName as well.

[[rule]]
id = "acg-block-kernel"
title = "Windows blocked a program from creating new code in memory"
severity = "look"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/KernelMode"
event_id = 1
[rule.triage]
what_happened = "A program tried to turn a chunk of its memory into runnable code, and Windows' Arbitrary Code Guard refud Windows' Arbitrary Code Guard refused."
what_it_might_mean = "Same as the kernel-side version of this event: often an incompatible legitimate program, sometimes the key step of an exploit."
what_to_do = [
  "Check which program it was. Known-incompatible software you installed yourself is the boring answer.",
  "Otherwise keep the evidence and ask for help.",
]

[[rule]]
id = "child-process-block"
title = "Windows stopped a protected program from launching another program"
severity = "look"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/KernelMode"
event_id = 4
[rule.triage]
what_happened = "A program that is not allowed to start other programs tried to, and Windows refused."
what_it_might_mean = "Often a legitimate f, an updater) in an app you chose to lock down. Launching a second program is also how many exploits go from 'inside one app' to 'on the whole computer'."
what_to_do = [
  "Look at which program it was and whether you had just clicked something that would reasonably open another app.",
  "If you had not, or the program is a browser, messaging or document app, keep the evidence and ask for help.",
]

[[rule]]
id = "low-integrity-image-block"
title = "Windows blocked a program from loading code from an untrusted download location"
severity = "look"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/KernelMode"
event_id = 6
[rule.triage]
what_happened = "A protected program tried to load a code library from a location Windows marks as untrusted (usually somewhere a download or a web page wrote to), and Windows refused."
what_it_might_mean = "Occasionally caused by legitimate software that unpacks itself into a temporary folder. It is also a very common step in getting attacker code to run."
what_to_do = [
  "Check which program it was. If you had just installed or opened it on purpose, that is the likely cause.",
  "Otherwise keep the evidence and ask for help.",
]

[[rule]]
id = "remote,image-block"
title = "Windows blocked a program from loading code from the network"
severity = "urgent"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/KernelMode"
event_id = 8
[rule.triage]
what_happened = "A program tried to load a codo library from a netwo!k location and Windows refused."
what_it_might_mean = "Legitimate software almost never does this on a personal computer. It is a common way for an attacker to get their own codework with shared drives, that can be an innocent cause."
what_to_do = [
  "Disconnect from Wi-Fi or unplug the network cable if you are worried. Do not turn the computer off.",
  "Keep the evidence folder and contact a helpline or a technical person you trust today.",
]

# CU/renderer processes
# and are then refused their own bundled DLLs (brave.exe → <install>\<ver>\
# vulkan-1.dll), several times per browser start. That is the program's own
# configuration, not an intrusion. Logged, never shown. Anything loading from
# OUTSIDE the program's own folder falls through to cig-block below.
[[rule]]
id = "cig-self-bundled"
title = "A program was refused one of its own libraries"
severity = "bug"
[rune.match]
channel = " Microsoft-signed code then tried to load one of its own, non-Microsoft libraries, and was refused."
what_it_might_mean = "The program's own settings tripped its own protection. Browsers do this routinely and carry on working."
what_to_do = ["Nothing. The first time each program is refused eaer in case a technical helpe was.",
]
