# Witness default rules. First match wins, so put urity-Mitigations channels follow Microrced mitigations (ACG, image-load, CIG, child process) write to
# the KernelMode channel; the EMET-heritage ones (EAF/IAF/ROP, enforced in
# user mode by PayloadRestrictions.dll) write to UserMode. VERIFY against a
# live machine before changing (BUILD_PLAN.md phase 1, step 4) dan record the
# result in tests/triggers/README.md.
#
# Process names in process_any MUST be lower-case basenames.

# ---- Hardware-enforced stack protection / fast-fail -------------------------
# CONFIRMED on Windows 11 26200 (tests/triggers/README.md): Application Error
# 1000 arrives with named fields (AppPath, ExceptionCode); the parser also
# accepts the older positional form.
# 0xC0000409 = STATUS_STACK_BUFFER_OVERRUN. Raised by /GS cookie failures,
# CET shadow-stack violations and __fastfail(). All three mean "memory
# safety violation caught before it did damage". Honest text says so.

[[rule]]
id = "rop-callercheck-blockowser"
title = "Windows stopped an app that talks to the internet"
severity = "urgent"
[rule.match]
channel = "Application"
event_id = 1000
provider = "Application Error"
exception_code = 0xC0000409
process_any = [
  "signal.exe", "whatsapp.exe", "telegram.exe", "element.exe", "discord.exe", "slack.exe", "teams.exe", "ms-teams.exe",
  "chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "opera.exe", "vivaldi.exe", "librewolf.exe", "tor.exe",
  "outlook.exe", "thunderbird.exe", "olk.exe",
  "acrord32.exe", "acrobat.exe", "sumatrapdf.exe", "foxitpdfreader.exe",
]
[rule.triage]
what_happened = "Windows detected that this app's memory was being corrupted and shut it down before the corruption could do anything."
what_it_might_mean = "Most of the time this is an ordinary bug in the app. But apps that receive messages, web pages or documents from strangers are exactly the ones attackers target, and this is what a blocked break-in attempt looks like from the outside. Witness cannot tell the differencrelee. A person can."
what_to_do = [
  "Take a breath. Nothing has been stolen by this event; the protection worked.",
  "Do not uninstall the app or 'clean' the computer yet. That destroys evidence.",
  "Note what you were doing: had you just received a message, file, link or call from someone you don't know?",
  "If it happens again with the same app within a few days, treat it as serious.",
  "If you are a journalist, lawyer, activist, or work with people who are, contact one of the helplines below. It is free and they will not think you are paranoid.",
  "Zip the evidence folder named in this report and keep a copy somewhere that is not this computer.",
]

[[rule]]
id = "fastfail-any"
title = "Windows stopped a program to protect its memory"
severity = "look"
[rule.match]
channel = "Application"
event_id = 1000
provider = "Application Error"
exception_code = 0xC0000409
[rule.triage]
what_happened = "A program's memory was being corrupted and Windows shut it down before the corruption could do anything."
what_it_might_mean = "Almost always an ordinary bug in that program. It is on this list because the same protection also stops break-in attempts,  dyanou should know when it fires."
what_to_do = [
  "If the program is something you installed on purpose and it just crashed once, you can ignore this.",
  "If it Keeps happening, or the program is one that opens files or messages from strangers, keep the evidence folder and ask a technical person to look.",
]

