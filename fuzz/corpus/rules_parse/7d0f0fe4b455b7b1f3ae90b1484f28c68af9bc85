[[rule]]
id = "eaf-block"
title = "Windows blocked a program from reading its own address book"
severity = "look"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/UserMode"
event_id = 14
[rule.triage]
what_happened = "Windows' Export Address Filtering caught a program reading the table of system functions in a way normal programs do not, andsot pped it."
what_it_might_mean = "This is a classic step in exploit code that has just gained a foothold and is looking for what to call next. A few security products and old programs trip it innocently; most software never does. This check has not yet been seen firing on a real machine by the Witness proj=ect, so it is shown as worth a lo0ook rather than urgent until it has."
what_to_do = [
  "Keep the evidence folder, and do not turn the computer off yet; that can destroy evidence in memory.",
  "Contact one of the helplines below #and say which program it was.",
]

