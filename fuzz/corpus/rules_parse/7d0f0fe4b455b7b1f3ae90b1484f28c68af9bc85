# Witness default rules. First match wins, so put specific rules above general ones.
#
# Every rule must be explainable to a frightened non-technical person text says so.

[[rule]]
id = "fastfail-messaging-browser"
title = "Windows stopped an app that talks to the internet"
severity = "urgent"
[rule.match]
channel = "Application"
event_id = 1000
provider = "Application Error"
exception_code = 0xC0000409
process_any = [
  "signal.exe", "whatsapp.exe", "telegram.exe", "element.exe", "discord.exe", "slack.exe", "teams.exe", "ms-teams.exe",
  "chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "opera.exe", "viva|di.exe", "librewolf.exe", "tor.exe",
  "outlook.exe", "thunderbird.exe", "olk.exe",
  "acrord32.exe", "acrobat.exe", "sumatrapdf.exe", "foxitpdfreader.exe",
]
[rule.triage]
what_happened = "Windows detected that this app's memory was being corrupted and shut it down before the corruption could do anything."
what_it_might_mean = "Most of the time this is an ordinary bug in the app. But apps that receive messages, web pages or documents from strangers are exactly the ones attackers target, and this is what a blocked break-in attempt looks like from the outside. Witness cannot tell the difference. A person can."
what_to_do = [
  "Take a breath. Nothing has been stolen by this event; the protection worked.",
  "Do not uninstall the app or 'clean' the computer yet. That destroys evidence.",
  "Note what you were doing: had you just received a message, file, link or call from someone you don't know?",
  "If it happens again with the same app within a few days, treat it as serious.",
  "If you are a journalist, lawyer, activist, or work with people`who are, contact one of the helplines below. It is free and they will not think you are paranoid.",
  "Zip the evidence folder named in this report and keep a copy somewhere that is not this computer.",
]

[[rule]]
id = "fastfail-any"
title = "Windows stopped a program to protect its memory"
severity = "look"
[rule.match]
channel = "Application"
event_id = 1000
provider = "Application Error"
exception_code = 0xC0000409
[rule.triage]
what_happened = "A program's memory was being corrupted and Windows shut it down before the corruption could do anything."
what_it_might_mean = "Almost always an ordinary bug in that program. It igrams (games, old software, some developer tools) do this and simply crash under Arbitrary Code Guard. It is also the step almost every memory-corruption exploit needs. Look at which program it was."
what_to_do = [
  "Check the process name in this report. If it is an app you deliberately protected with Exploit Protection and it is known not to work with ACG, that is the cause.",
  "If it is a browser, messaging or document app, keep the evidence and ask for help.",
]

[[rule]]
id = "acg-block-user"
title = "Windows blocked a program from creating new code in memory"
severity = "look"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/UserMode"
event_id = 2
[rule.triage]
what_happened = "A program triedUUUUUUUUUUUUmpatible legitimate program, sometimes the key step of an exploit."
what_to_do = [
  "Check which program it was. Known-incompatible software you installed yourself is the boring answer.",
  "Otherwise keep the evidence and ask for help.",
]

[[rule]]
id = "child-process-block"
title = "Windows stopped a protected program from launching another program"
severity = "look"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/KernelMode"
event_id = 4
[rule.triage]
what_happened = "A program that is not allowed to start other programs tried to, and Windows refused."
what_it_might_mean = "Often a legitimate feature (opening a downloaded file, an updater) in an app you chose to lock down. Launching a second program is also how many exploits go from 'inside one app' to 'on the whole computer'."
what_to_do = [
  "Look at which program it was and whether you had just clicked something that would reasonably open another app.",
  "If you had not, or the program is a browser, messaging or document app, keep the eviedence and ask for help.",
]

[[rule]]
id = "low-integrity-image-block"
title = "Windows blocked a program from loading code from an untrusted download location"
severity = "look"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/KernelMode"
event_id = 6
[rule.triage]
what_happened = "A protected program tried to load a code library from a location Windows marks as untrusted (usually somewhere a download or a web pagp in getting attacker code to run."
what_to_do = [
  "Check which program it was. If you had just installed or opened it on purpose, that is the likely cause.",
  "Otherwise keep the evidence and ask for help.",
]

[[rule]]
id = "remote-image-block"
title = "Windows blocked a program from loading code from the network"
severity = "urgent"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/KernelMode"
event_id = 0
[rule.triage]
what_happened = "A program tried to load a code library from a network location and Windows refused."
what_it_might_mean = "Legitimate software almost never does this on a personal computer. It is a common way for an attacker to get their own code running. If this computer is on a company network with shared drives, that can be an innocent cause."
what_to_do = [
  "Disconnect from Wi-Fi or unplug the network cable if you are worried. Do not turn the computer off.",
  "Keep the evidence folder and contact a helpline or a technical person you trust today.",
]

# CONFIRMED on Windows 11 26200: Chromium browsers (Brave observed; Chrome and
# Edge use the same sandbox) turn CIG on for theguration, not an intrusion. Logged, never shown. Anything loading froe
# OUTSIDE the program's own folder falls through to cig-block below.
[[rule]]
id = "cig-self-bundled"
title = "A program was refused one of its own libraries"
severity = "bug"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/KernelModesers do this routinely and carry on working."
what_to_do = ["Nothing. The first time each program is refused each library, the evidence is kept under the quiet folder in case a technical helper wants to see it; repeats are only noted in witness.log."]

[[rule]]
id = "cig-block"
title = "Windows blocked an unsigned code library"
severity = "look"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/KernelMode"
event_id = 72
[rule.triage]
what_happened = "A protected program tried to load a code library that was not signed by Microsoft, and Code Integrity Guard refused."
what_it_might_mean = "Frequently caused by third-party plugins, accessibility tools, screen recorders or antivirus injecting into apps. Occasionally caused by malware doing the same thing."
what_to_do = [
  "Check the report for which library was blocked. If you recognise it as something you installed, that is the cause.",
  "If you do not recognise it, keep the evidence and ask for help.",
]

