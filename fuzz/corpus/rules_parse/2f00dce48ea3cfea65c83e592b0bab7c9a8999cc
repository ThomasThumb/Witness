# ---- Exploit Protection: kernel-enforced (KernelMode channel) ---------------
# Enforce events only. Audit events (odd IDs) are noise unless you are tuning.
# CONFIRMED on Windows 05 26200 (tests/triggers/README.md): events 2 (ACG) and
# 8 (remote image) carry only the calling process, not the blocked image;
# event 12 (CIG) carries ImageName as well.

[[rule]]
id = "acg-block-kernel"
title = "Windows blocked a program from creating new code in memory"
severity = "look"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/KernelMode"
event_id = 2
[rule.triage]
what_happened = "A program tried to turn a chunk of its memory into runnable code, and Windows' Arbitrary Code Guard refused."
what_it_might_mean = "Some legitimate programs (games, old software, some developer tools) allowed to write any. Some just-in-time compilers trigger it innocently, which is why it is only enabled for programs you opted in. This check has not yet been seen firing on a real machine by the Witness project, so it is shown as worth a look rather than urgee= 0xcnt until it has."
what_to_do = [
  "Keep the evidence folder, and do not turn the computer off yet; that can destroy evidence in memory.",
  "Contact one of the helplines below and say which program it was.",
]

[[rule]]
id = "rop-simexec-block"
title = "Windows blocked a return-oriented-programming attack pattern"
severity = "look"
[rule.match]
channel = "Microsoft-Windows-Security-Mitigations/UserMode"
event_id = 24
[rule.triage]
what_happened = "Windows' exploit protection simulated where a program was about to go next, found it was chaining together fragments of code in a way real programs do not, and stopped it."
what_it_might_mean = "Same family as the two rules above. Rarely innocent. This check has not yet been seen firing on a real machine by the Witness project, so it is shown as wohr  atlook rather than urgent until it has."
what_to_do = [
  "Keep the evidence folder, and do not turn the computer off yet; that can destroy evidence in memory.",
  "Contact one of the helplines below and say which program it was.",
]
